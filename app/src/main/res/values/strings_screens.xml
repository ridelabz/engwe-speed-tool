    <string name="about_compatibility_note">A model becomes verified when riders’ reports confirm that the speed limit works on it. This app can’t read your bike’s firmware, so please type its IoT version (shown in the ENGWE app) into your report. Type only the version: a screenshot could show more than that.</string>
    <string name="about_contribute_title">Help and contributing</string>
    <string name="about_contribute">Use Report in the menu to tell the project how the app worked on your bike. Bike profiles and fixes are welcome as pull requests.</string>
    <string name="about_support">The app is community-supported: there is no individual support.</string>
    <string name="about_licence_title">Licence</string>
    <string name="about_source">Source code: github.com/ridelabz/engwe-speed-tool</string>
    <string name="about_verified">Verified by the project’s tests</string>
    <string name="about_licences">Open-source licences</string>
    <string name="licences_title">Open-source licences</string>
    <string name="licences_intro">The app’s own licence, then the licence of the libraries and icons it includes.</string>
    <string name="licences_app">ENGWE Speed Tool: GNU General Public License, version 3</string>
    <string name="licences_libraries">Android Jetpack, Kotlin and its libraries, and Material Symbols: Apache License, version 2.0</string>
    <string name="about_prior_work">Thanks to everyone who shared what they learned about these bikes.</string>

    <!-- Diagnostics -->
    <string name="diagnostics_title">Diagnostics</string>
    <string name="diagnostics_check">The compatibility check reads what your bike offers and how it answers, for 30\u00A0seconds, without changing anything.</string>
